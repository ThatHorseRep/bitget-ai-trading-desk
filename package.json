{
  "name": "bitget-ai-redteam-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:core",
    "test:core": "npm run build:core && node --env-file-if-exists=.env.local --test tests/*.test.cjs",
    "check:docs": "node scripts/check-docs-drift.cjs",
    "build:core": "tsc -p tsconfig.core.json",
    "verify-clean": "npm ci && npm run typecheck && npm run lint && npm run test && npm run build",
    "verify-paper-trading": "npm run build:core && npx tsc src/scripts/verify-paper-trading.ts --outDir .paper-verify --skipLibCheck --target ES2022 --module CommonJS --moduleResolution Node --esModuleInterop && node .paper-verify/scripts/verify-paper-trading.js",
    "postinstall": "node scripts/ensure-bin-links.cjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "lightningcss": "^1.30.2",
    "lucide-react": "^1.48.0",
    "next": "^16.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "tailwindcss": "4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-win32-x64-msvc": "4.1.17",
    "lightningcss-linux-x64-gnu": "^1.30.2",
    "lightningcss-win32-x64-msvc": "1.30.2"
  },
  "description": "Adversarial pre‑trade risk workbench for tokenized equities"
}
