# Template for local secrets. Do not add real credentials to this file.
# Copy to .env.local (gitignored) and fill in. CI runs the suite without
# any env file — tests are hermetic and stub all network calls.

# Added now because later vertical-slice integrations will need them.
BITGET_API_BASE_URL=https://api.bitget.com
NVDA_REFERENCE_BASE_URL=
EVIDENCE_BASE_URL=

# Hackathon LLM gateway (OpenAI-compatible /chat/completions endpoint).
# The gateway's qwen3.8-max is a Qwen3-class "thinking" model; llmClient
# sends enable_thinking:false by default for latency — set
# LLM_ENABLE_THINKING=1 to opt back in where supported.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_ENABLE_THINKING=
