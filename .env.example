# Template for local secrets. Copy to .env.local (gitignored) and fill in.
# NEVER commit real values; CI runs the suite without any env file.
# The LLM client degrades gracefully when these are absent (tests stub fetch).

# Hackathon LLM gateway (OpenAI-compatible /chat/completions endpoint).
LLM_API_BASE_URL=
LLM_API_KEY=
# Model id served by the gateway. qwen3.8-max is a Qwen3-class "thinking"
# model; llmClient sends enable_thinking:false by default for latency
# (set LLM_ENABLE_THINKING=1 to opt back in where supported).
LLM_MODEL=
LLM_ENABLE_THINKING=
